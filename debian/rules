#!/usr/bin/make -f
# You must remove unused comment lines for the released package.
#export DH_VERBOSE = 1
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all
#export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
#export DEB_LDFLAGS_MAINT_APPEND = -Wl,-O1

PKG_VERSION := $(shell dpkg-parsechangelog -S Version | sed 's/~.*//')
PKG_SOURCE  := $(shell jq -r '.name' composer.json)

%:
	dh $@


override_dh_install:
	mkdir -p debian/tmp/
	jq '.version = "'`dpkg-parsechangelog | sed -n 's/^Version: //p'| sed 's/~.*//'`'"'  composer.json |sponge debian/tmp/composer.json
	dh_install
	# Use the shipped static autoloader (system package autoloaders + PSR-4)
	# instead of a composer-debian vendor dir that is never populated.
	# autoload.php + composer.json live in /usr/lib/php/multiflexi-eventor;
	# the daemon and its classes stay in /usr/lib/multiflexi-eventor.
	sed -i -e 's/.\.\/vendor/\/usr\/lib\/php\/multiflexi-eventor/g' debian/multiflexi-eventor*/usr/lib/multiflexi-eventor/*.php
	sed -i -e 's/\.\.\/\.env/\/etc\/multiflexi\/\multiflexi\.env/g' debian/multiflexi-eventor*/usr/lib/multiflexi-eventor/*.php
	sed -i "s|'unknown'|'$(PKG_SOURCE)'|" debian/multiflexi-eventor/usr/lib/php/multiflexi-eventor/autoload.php
	sed -i "s|'0.0.0'|'$(PKG_VERSION)'|"  debian/multiflexi-eventor/usr/lib/php/multiflexi-eventor/autoload.php
