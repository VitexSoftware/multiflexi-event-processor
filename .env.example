DB_CONNECTION=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=multiflexi
DB_USERNAME=multiflexi
DB_PASSWORD=changeme
APP_DEBUG=false
EASE_LOGGER=syslog
MULTIFLEXI_DAEMONIZE=true
MULTIFLEXI_CYCLE_PAUSE=10

# Node-RED bridge (leave NODERED_WEBHOOK_URL empty to disable)
# Forwards webhook changes and finished jobs to a Node-RED HTTP-in endpoint.
NODERED_WEBHOOK_URL=
# Catalog feed: pushes companies, enabled run-templates and credentials to the
# node-red-contrib-multiflexi catalog node so it can build palette nodes.
# Leave empty to disable. Use a path distinct from NODERED_WEBHOOK_URL.
NODERED_CATALOG_URL=
# How often (seconds) to republish the catalog (content-hashed; unchanged skipped)
NODERED_CATALOG_INTERVAL=300
# Optional shared secret sent as the X-MultiFlexi-Token header
NODERED_TOKEN=
# HTTP request timeout in seconds
NODERED_TIMEOUT=5
# Forward incoming webhook changes (true/false)
NODERED_FORWARD_CHANGES=true
# Persisted high-water mark for forwarded jobs
NODERED_JOB_STATE_FILE=/var/lib/multiflexi-eventor/last_forwarded_job
# Batch limits per poll cycle
MULTIFLEXI_EVENT_BATCH=100
MULTIFLEXI_JOB_BATCH=100
